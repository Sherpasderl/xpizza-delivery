# Copy to .env on the Surface and fill in. Never commit the real .env or the service account.
FB_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
RESTAURANT_ID=x_pizza

# Epson TM-T20IV. VID is Epson (0x04B8). VERIFY the PID with Zadig — the -SP variant
# may differ from the 0x0202 default.
USB_VID=0x04B8
USB_PID=0x0202

# Print-claim lease (ms) before another agent may reclaim a stuck job.
PRINT_CLAIM_TTL_MS=60000
