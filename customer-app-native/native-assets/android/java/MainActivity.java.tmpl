package __PACKAGE__;

import android.content.res.Configuration;
import android.os.Bundle;
import androidx.core.content.ContextCompat;
import com.getcapacitor.BridgeActivity;

// PLAN-capp-dark-mode §4 (Codex r2 #2): the window colour alone does not colour the WebView — Capacitor's Bridge sets the WebView
// background only from its single-valued `backgroundColor` config, so it would draw white before the CSS. The WebView is painted
// with the THEME's page colour (@color/page_bg resolves through values-night/) after onCreate (before its first draw), on a
// configuration change (uiMode stays in configChanges: a theme switch does not recreate the activity) and on every resume.
public class MainActivity extends BridgeActivity {
    private void paintWebView() {
        if (getBridge() == null || getBridge().getWebView() == null) return;
        getBridge().getWebView().setBackgroundColor(ContextCompat.getColor(this, R.color.page_bg));
    }

    @Override
    public void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        paintWebView();
    }

    @Override
    public void onConfigurationChanged(Configuration newConfig) {
        super.onConfigurationChanged(newConfig);
        paintWebView();
    }

    @Override
    public void onResume() {
        super.onResume();
        paintWebView();
    }
}
