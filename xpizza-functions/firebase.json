{
  "database": {
    "rules": "database.rules.json",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run check:rules"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run test:catalog-rules",
      "npm --prefix \"$RESOURCE_DIR\" run test:catalog-parity",
      "npm --prefix \"$RESOURCE_DIR\" run test:pricing-cutover"
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "predeploy": [
        "node \"$RESOURCE_DIR/tools/deploy-env-guard.js\" --root \"$RESOURCE_DIR\""
      ],
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env",
        ".env.example",
        ".env.local",
        ".env.local.*",
        ".env.local~",
        ".env.bak",
        ".env~",
        ".env.*.bak",
        ".env.*~",
        ".env.*",
        "README.md",
        ".firebase",
        "firebase.emulator.*.json",
        "firebase-export-*"
      ]
    }
  ]
}
