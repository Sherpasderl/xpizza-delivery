# Copy this to .env (without .example) and fill in real values.
# Run from xpizza-functions/. Never commit .env.

# ---- Order-intake bearer token (legacy name MAKE_SECRET; now the generic bearer) ----
# Despite the name, this is the PUBLIC bearer the browser order form sends to
# createOrder / chargeOnlineOrder / confirmOnlinePayment. It is embedded in the
# order-form HTML by design. Generate: openssl rand -hex 32
MAKE_SECRET=replace_me_with_a_long_random_string_at_least_40_chars

# ---- Dispatcher-only reconciliation secret (resolveManualReconciliation) ----
# SEPARATE from MAKE_SECRET — must NEVER be shipped to the browser. resolveManual-
# Reconciliation can materialize an order or trigger a void/refund, so it is gated
# on this server-only secret (fail-closed if unset). Generate: openssl rand -hex 32
RECON_SECRET=replace_me_with_a_long_random_string_server_only

# ---- Web Push (driver notifications) ----
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must also be pasted into xpizza-driver/index.html (must match).
# VAPID_SUBJECT must be a real mailto: or https:// — push services use it to
# contact you if your app misbehaves.
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:xavierlacayo@gmail.com

# ---- UltraMsg WhatsApp (outbound) ----
# Instance ID + API token from ultramsg.com dashboard.
ULTRAMSG_INSTANCE_ID=replace_me
ULTRAMSG_TOKEN=replace_me

# ---- UltraMsg inbound webhook auth ----
# Shared secret validated by onIncomingWhatsApp. UltraMsg's UI doesn't support
# custom headers, so it travels as ?secret=... query param on the webhook URL.
# Generate: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=replace_me_with_a_long_random_string_at_least_40_chars

# ---- KDS cancellation sync (v1.6.0+) ----
# Google Sheets API target. The sheet must be shared (Editor access) with the
# Cloud Function's service account email. KDS_SHEET_NAME defaults to 'Pedidos'
# if unset, but set explicitly for clarity.
KDS_SHEET_ID=replace_me
KDS_SHEET_NAME=Pedidos

# ---- PixelPay online card payment (server-side) ----
# From the PixelPay portal: Preferences > API Options ("Opciones del API").
# Architecture: the browser SDK runs a 3DS AUTH with the PUBLIC app_key + auth_hash;
# the server confirms via doCapture (key+hash). The RAW secret stays here (server only)
# and is used ONLY to verify the capture payment_hash and to sign voids — never sent to
# the browser, never used to sign the sale (the SDK has no x-client-signature).
#
# !! The portal shows BOTH a masked "Secret Key" AND a visible "Public key".
#    PIXELPAY_SECRET must be the MASKED "Secret Key" (raw). The visible "Public
#    key" is SHA512(secret) — it goes in PIXELPAY_PUBLIC_KEY (= x-auth-hash), NEVER in _SECRET.
PIXELPAY_ENDPOINT=https://...           # "Endpoint" in API Options
PIXELPAY_KEY_ID=replace_me              # "Key ID" — x-auth-key, identifies the merchant
PIXELPAY_SECRET=replace_me              # "Secret Key" — the MASKED/raw value (NOT the public key)
PIXELPAY_PUBLIC_KEY=replace_me          # "Public key" = SHA512(secret) = x-auth-hash; browser SDK credential
PIXELPAY_MERCHANT_EMAIL=replace_me      # authorized merchant user email — used for void auth_user (SHA512)
# PIXELPAY_ENV=                         # leave unset for production; the SANDBOX config sets it to "sandbox".
#                                       # Only override if PixelPay's prod gateway requires env="live".
#
# Mode switch: 'sandbox' (pixelpay.dev, built-in public test creds — no real
# money) or 'production' (uses the ENDPOINT/KEY_ID/SECRET/PUBLIC_KEY above).
PIXELPAY_MODE=sandbox
# app_url folded into the x-client-signature. VERIFY the exact value against a
# sandbox sale before relying on it. Defaults to the order-form origin.
PIXELPAY_APP_URL=https://xpizzaorders.netlify.app
# order_callback webhook receiver (pixelPayWebhook — implemented in Stage 4).
PIXELPAY_CALLBACK_URL=https://us-central1-xpizza-delivery.cloudfunctions.net/pixelPayWebhook
# HOSTED PAYMENT: shared secret embedded in the `_callback` URL (?secret=…). The webhook
# authenticates EVERY hosted callback against it before acting (paid callbacks are also bound
# by payment_hash; non-paid callbacks rely on this). STRONGLY RECOMMENDED in production — without
# it a forged callback could be processed. Set the SAME value here and it auto-appends to _callback.
# Generate: openssl rand -hex 32
PIXELPAY_WEBHOOK_SECRET=replace_me
# Sandbox-only: which PixelPay test amount (1-14) to charge (1=success, 2=declined,
# …). Lets you exercise outcomes the sandbox gates on order_amount. Ignored in production.
PIXELPAY_SANDBOX_AMOUNT=1
