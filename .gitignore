# =============================================================================
# X Pizza Delivery — .gitignore
# =============================================================================
# Things git should NEVER track. Anything containing secrets, build artifacts,
# editor cruft, or environment-specific settings goes here.

# ----- Secrets -----
# .env contains MAKE_SECRET, VAPID keys, KDS_SHEET_ID — never commit
.env
.env.local
.env.*.local
*.pem
*.key
# Local helper script — contains real secrets (MAKE_SECRET etc), never commit
run_patches.sh

# Generated at deploy time by `npm run sync:rules` — canonical copy lives in
# xpizza-reference/database.rules.json. This is just the deploy artifact.
xpizza-functions/database.rules.json

# ----- Node.js -----
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/

# ----- Firebase -----
.firebase/
firebase-debug.log*
firebase-debug.*.log
.runtimeconfig.json

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ----- Logs -----
*.log
logs/

# ----- Build artifacts (none yet, but reserve) -----
dist/
build/
out/

# ----- Old backups in working folders -----
*.bak
*.backup
*~

# ----- Temporary files used during testing -----
/tmp/
*.tmp

# Local Netlify folder
.netlify
xpizza-orders/images.bak-*

# Visual-companion brainstorm mockups (local only)
.superpowers/

# Generated per-run emulator config (tools/emulator-run.js writes it next to firebase.json so the
# relative rules paths resolve, then deletes it). Never committed: its ports are per-checkout.
xpizza-functions/firebase.emulator.*.json
