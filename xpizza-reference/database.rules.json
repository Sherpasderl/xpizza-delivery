{
  "rules": {
    "dispatchers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()"
      }
    },

    "drivers": {
      ".read": "auth != null",
      "$driver_id": {
        ".write": "auth != null && (auth.uid === $driver_id || root.child('dispatchers').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['name'])",
        "status": {
          ".validate": "newData.val() === 'off_shift' || newData.val() === 'available' || newData.val() === 'assigned' || newData.val() === 'at_restaurant' || newData.val() === 'en_route_delivery' || newData.val() === 'returning' || newData.val() === 'on_break'"
        },
        "lat": { ".validate": "newData.isNumber() || newData.val() === null" },
        "lng": { ".validate": "newData.isNumber() || newData.val() === null" },
        "push_reachable": {
          ".validate": "newData.isBoolean() && root.child('dispatchers').child(auth.uid).exists()"
        },
        "location_source":      { ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "current_shift_id":     { ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "current_hub_lat":      { ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "current_hub_lng":      { ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "current_restaurant_id":{ ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "current_hub_task_id":  { ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "ingest_token_hash":    { ".validate": "root.child('dispatchers').child(auth.uid).exists()" },
        "last_location_ts":     { ".validate": "root.child('dispatchers').child(auth.uid).exists()" }
      }
    },

    "tasks": {
      ".read": "auth != null",
      ".indexOn": ["assigned_driver_id", "order_id", "status", "type"],
      "$task_id": {
        ".write": "auth != null && (root.child('dispatchers').child(auth.uid).exists() || (data.exists() && data.child('assigned_driver_id').val() === auth.uid))",
        ".validate": "newData.hasChildren(['order_id', 'type', 'status'])",
        "type": {
          ".validate": "newData.val() === 'pickup' || newData.val() === 'delivery'"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'assigned' || newData.val() === 'accepted' || newData.val() === 'in_progress' || newData.val() === 'completed' || newData.val() === 'cancelled'"
        }
      }
    },

    "orders": {
      ".read": "auth != null",
      ".indexOn": ["status", "created_at", "order_type"],
      "$order_id": {
        ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()",

        "status": {
          ".write": "auth != null && (root.child('dispatchers').child(auth.uid).exists() || root.child('kitchen').child(auth.uid).exists() || root.child('tasks').child($order_id + '_delivery').child('assigned_driver_id').val() === auth.uid || root.child('tasks').child($order_id + '_pickup').child('assigned_driver_id').val() === auth.uid) && !(newData.val() === 'cancelled' && root.child('orders').child($order_id).child('payment_method').val() === 'online' && (root.child('orders').child($order_id).child('payment_status').val() === 'confirmed' || root.child('orders').child($order_id).child('payment_status').val() === 'pending'))"
        },
        "picked_up_at": {
          ".write": "auth != null && (root.child('dispatchers').child(auth.uid).exists() || root.child('tasks').child($order_id + '_pickup').child('assigned_driver_id').val() === auth.uid)"
        },
        "delivered_at": {
          ".write": "auth != null && (root.child('dispatchers').child(auth.uid).exists() || root.child('tasks').child($order_id + '_delivery').child('assigned_driver_id').val() === auth.uid)"
        }
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()"
    },

    "dispatcher_alerts": {
      ".read": "auth != null && root.child('dispatchers').child(auth.uid).exists()",
      ".indexOn": ["created_at"],
      "$alert_id": {
        ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()"
      }
    },

    "order_tracking": {
      "$token": {
        ".read": true,
        ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()"
      }
    },

    "order_events":     { ".read": false, ".write": false },
    "order_timelines":  { ".read": "auth != null", ".write": false },
    "order_predictions":{ ".read": false, ".write": false },
    "prediction_logs":  { ".read": false, ".write": false },
    "ready_time_config":{ ".read": false, ".write": false },
    "ready_time_quality":{ ".read": false, ".write": false },
    "ready_time_model":  { ".read": false, ".write": false },

    "incoming_messages": {
      ".read": "auth != null && root.child('dispatchers').child(auth.uid).exists()",
      ".indexOn": ["received_at", "handled"],
      "$msg_id": {
        ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()"
      }
    },

    "kitchen": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()"
      }
    },

    "driver_cash": {
      "$driver_id": {
        ".read": "auth != null && (auth.uid === $driver_id || root.child('dispatchers').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $driver_id",
        "$shift_id": {
          "cuadre": {
            ".validate": "newData.hasChildren(['cash_owed','cash_order_count','closed_at'])",
            "cash_owed": { ".validate": "newData.isNumber()" },
            "cash_order_count": { ".validate": "newData.isNumber()" },
            "closed_at": { ".validate": "newData.isNumber()" }
          }
        }
      }
    },
    "driver_push_tokens": { ".read": false, ".write": false },
    "driver_tokens":      { ".read": false, ".write": false },

    "payment_attempts": { ".read": false, ".write": false },
    "webhook_events":   { ".read": false, ".write": false },
    "outbox":           { ".read": false, ".write": false },
    "refund_attempts":  { ".read": false, ".write": false },
    "payment_audit":    { ".read": false, ".write": false },

    "facturas": { ".read": false, ".write": false },
    "restaurants": {
      "$restaurant_id": {
        "factura_config": { ".read": false, ".write": false },
        "identity": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('dispatchers').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['name','hub_lat','hub_lng','phone','whatsapp_instance','whatsapp_enabled','delivery_radius_km','hours','active','version'])",
          "hub_lat":  { ".validate": "newData.isNumber()" },
          "hub_lng":  { ".validate": "newData.isNumber()" },
          "active":   { ".validate": "newData.isBoolean()" },
          "version":  { ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())" },
          "whatsapp_enabled":   { ".validate": "newData.isBoolean()" },
          "delivery_radius_km": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
